# Copy this file to .env and fill in real values. Never commit .env.
# See the README for how each of these is used.

# --- required ---
# A long, random, secret string used to sign access tokens and OAuth
# state parameters. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# --- optional (sensible defaults if unset) ---
PORT=3000
DB_PATH=auth.sqlite
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# --- OAuth providers (optional -- a provider is only enabled once all
# three of its variables are set; the others just don't 404 anymore) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/api/auth/oauth/github/callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/oauth/google/callback
